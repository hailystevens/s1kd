/*
 * IETM VI — Interface Foundation v1.0
 * Chat-inspired, independently authored design system.
 * Scope: wrap the application in <div class="ietm-ui" data-theme="light">.
 * Change data-theme to "dark" or "system" (system is handled through prefers-color-scheme).
 * No external fonts, JavaScript, libraries or network dependencies required.
 * Optional Lucide icon SVGs: .ui-icon, or use inline SVG with aria-hidden="true".
 * Technical WARNING / CAUTION / NOTE formatting is a reference implementation only;
 * the program's approved IETM requirements supersede these styles.
 */

/* 01. Foundation and palettes */
.ietm-ui {
  color-scheme: light;
  --canvas: #ffffff;
  --app-bg: #f7f7f8;
  --surface: #ffffff;
  --surface-raised: #ffffff;
  --surface-muted: #f5f5f5;
  --surface-soft: #fafafa;
  --surface-hover: #f0f0f0;
  --surface-active: #ebebeb;
  --surface-inverse: #242424;
  --backdrop: rgb(14 18 24 / 0.48);
  --text: #242424;
  --text-secondary: #626262;
  --text-tertiary: #858585;
  --text-disabled: #a0a0a0;
  --text-inverse: #ffffff;
  --border: #e5e5e5;
  --border-subtle: #ededed;
  --border-strong: #c6c6c6;
  --focus: #326fbe;
  --accent: #2669a9;
  --accent-hover: #16558f;
  --accent-soft: #eaf3fa;
  --accent-on: #ffffff;
  --positive: #247d58;
  --positive-soft: #e9f5ed;
  --warning: #966314;
  --warning-soft: #fff5df;
  --danger: #bb3d3d;
  --danger-soft: #fff0ef;
  --neutral-soft: #f2f2f2;
  --selection: #dbeafe;
  --code-bg: #f4f4f4;
  --table-stripe: #fafafa;
  --graph-grid: #e6e9ed;
  --shadow-sm: 0 1px 3px rgb(0 0 0 / .05);
  --shadow-md: 0 5px 24px rgb(0 0 0 / .09);
  --shadow-lg: 0 16px 60px rgb(0 0 0 / .17);
  --font-sans: -apple-system, BlinkMacSystemFont, "Segoe UI", Inter, "Helvetica Neue", Arial, sans-serif;
  --font-mono: "Cascadia Code", "SFMono-Regular", Consolas, "Liberation Mono", monospace;
  --text-xs: .75rem;
  --text-sm: .875rem;
  --text-md: 1rem;
  --text-lg: 1.125rem;
  --text-xl: 1.375rem;
  --text-2xl: 1.75rem;
  --text-3xl: 2.25rem;
  --line-tight: 1.22;
  --line-normal: 1.5;
  --line-reading: 1.72;
  --space-0: 0;
  --space-1: .25rem;
  --space-2: .5rem;
  --space-3: .75rem;
  --space-4: 1rem;
  --space-5: 1.25rem;
  --space-6: 1.5rem;
  --space-8: 2rem;
  --space-10: 2.5rem;
  --space-12: 3rem;
  --space-16: 4rem;
  --radius-xs: 4px;
  --radius-sm: 6px;
  --radius-md: 9px;
  --radius-lg: 12px;
  --radius-xl: 16px;
  --radius-2xl: 22px;
  --radius-pill: 999px;
  --control-height-sm: 30px;
  --control-height: 38px;
  --control-height-lg: 46px;
  --sidebar-width: 264px;
  --content-width: 860px;
  --topbar-height: 58px;
  --ease: cubic-bezier(.2,.7,.2,1);
  --duration-fast: 120ms;
  --duration-normal: 180ms;
  font-family: var(--font-sans);
  font-size: 16px;
  line-height: var(--line-normal);
  color: var(--text);
  background: var(--app-bg);
  min-height: 100%;
  -webkit-font-smoothing: antialiased;
  text-rendering: optimizeLegibility;
}
.ietm-ui[data-theme="dark"] { color-scheme: dark; }
.ietm-ui[data-theme="dark"], .ietm-ui .ui-dark {
  --canvas: #212121;
  --app-bg: #171717;
  --surface: #212121;
  --surface-raised: #292929;
  --surface-muted: #2b2b2b;
  --surface-soft: #252525;
  --surface-hover: #303030;
  --surface-active: #383838;
  --surface-inverse: #f5f5f5;
  --backdrop: rgb(0 0 0 / .7);
  --text: #ececec;
  --text-secondary: #b8b8b8;
  --text-tertiary: #999999;
  --text-disabled: #777777;
  --text-inverse: #202020;
  --border: #3c3c3c;
  --border-subtle: #343434;
  --border-strong: #686868;
  --focus: #91c1ff;
  --accent: #9ac7eb;
  --accent-hover: #c0e1fa;
  --accent-soft: #1d3546;
  --accent-on: #16252e;
  --positive: #77cda4;
  --positive-soft: #203a2e;
  --warning: #ecc177;
  --warning-soft: #3f321e;
  --danger: #f19a98;
  --danger-soft: #422727;
  --neutral-soft: #343434;
  --selection: #2b5078;
  --code-bg: #303030;
  --table-stripe: #272727;
  --graph-grid: #363b40;
  --shadow-sm: 0 1px 4px rgb(0 0 0 / .18);
  --shadow-md: 0 8px 30px rgb(0 0 0 / .32);
  --shadow-lg: 0 22px 70px rgb(0 0 0 / .55);
}
@media (prefers-color-scheme: dark) {
 .ietm-ui[data-theme="system"] {
  color-scheme: dark;
  --canvas:#212121; --app-bg:#171717; --surface:#212121; --surface-raised:#292929;
  --surface-muted:#2b2b2b; --surface-soft:#252525; --surface-hover:#303030;
  --surface-active:#383838; --surface-inverse:#f5f5f5; --backdrop:rgb(0 0 0 / .7);
  --text:#ececec; --text-secondary:#b8b8b8; --text-tertiary:#999;
  --text-disabled:#777; --text-inverse:#202020; --border:#3c3c3c;
  --border-subtle:#343434; --border-strong:#686868; --focus:#91c1ff;
  --accent:#9ac7eb; --accent-hover:#c0e1fa; --accent-soft:#1d3546;
  --accent-on:#16252e; --positive:#77cda4; --positive-soft:#203a2e;
  --warning:#ecc177; --warning-soft:#3f321e; --danger:#f19a98;
  --danger-soft:#422727; --neutral-soft:#343434; --selection:#2b5078;
  --code-bg:#303030; --table-stripe:#272727; --graph-grid:#363b40;
  --shadow-sm:0 1px 4px rgb(0 0 0 / .18);
  --shadow-md:0 8px 30px rgb(0 0 0 / .32);
  --shadow-lg:0 22px 70px rgb(0 0 0 / .55);
 }
}

/* 02. Scoped reset. No global HTML/body overrides. */
.ietm-ui, .ietm-ui *, .ietm-ui *::before, .ietm-ui *::after { box-sizing: border-box; }
.ietm-ui :where(h1,h2,h3,h4,h5,h6,p,figure,blockquote,dl,dd) { margin: 0; }
.ietm-ui :where(button,input,select,textarea) { font: inherit; }
.ietm-ui :where(button,select) { cursor: pointer; }
.ietm-ui :where(button:disabled,input:disabled,select:disabled,textarea:disabled) { cursor: not-allowed; opacity: .56; }
.ietm-ui :where(img,svg,video,canvas) { max-width: 100%; }
.ietm-ui :where(img,video) { display: block; height: auto; }
.ietm-ui :where(a,button,input,select,textarea,[role="button"],summary):focus-visible {
  outline: 2px solid var(--focus); outline-offset: 3px;
}
.ietm-ui ::selection { background: var(--selection); }
.ietm-ui .ui-sr-only { position: absolute!important; width: 1px!important; height: 1px!important; padding: 0!important; margin: -1px!important; overflow: hidden!important; clip: rect(0,0,0,0)!important; white-space: nowrap!important; border: 0!important; }
.ietm-ui .ui-scroll { overflow:auto; scrollbar-color: var(--border-strong) transparent; scrollbar-width: thin; }
.ietm-ui .ui-truncate { overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.ietm-ui .ui-muted { color:var(--text-secondary); }
.ietm-ui .ui-faint { color:var(--text-tertiary); }
.ietm-ui .ui-mono { font-family: var(--font-mono); font-variant-numeric: tabular-nums; }
.ietm-ui .ui-numeric { font-variant-numeric: tabular-nums; }

/* 03. Layout — full app shell and content canvas */
.ietm-ui .ui-app { min-height:100vh; display:grid; grid-template-columns:var(--sidebar-width) minmax(0,1fr); }
.ietm-ui .ui-sidebar { position:sticky; top:0; height:100vh; min-width:0; overflow:auto; background:var(--app-bg); border-right:1px solid var(--border-subtle); padding:var(--space-4) var(--space-3); }
.ietm-ui .ui-main { min-width:0; background:var(--canvas); }
.ietm-ui .ui-topbar { min-height:var(--topbar-height); display:flex; gap:12px; align-items:center; justify-content:space-between; padding:10px clamp(16px,3vw,32px); border-bottom:1px solid var(--border-subtle); background:var(--canvas); }
.ietm-ui .ui-content { width:min(100%,calc(var(--content-width) + 2 * clamp(18px,4vw,48px))); margin-inline:auto; padding:clamp(20px,4vw,48px); }
.ietm-ui .ui-reading { max-width:var(--content-width); margin-inline:auto; }
.ietm-ui .ui-narrow { max-width:670px; margin-inline:auto; }
.ietm-ui .ui-wide { max-width:1200px; margin-inline:auto; }
.ietm-ui .ui-stack { display:flex; flex-direction:column; gap:var(--space-4); min-width:0; }
.ietm-ui .ui-stack-sm { gap:var(--space-2); }
.ietm-ui .ui-stack-lg { gap:var(--space-8); }
.ietm-ui .ui-row { display:flex; align-items:center; gap:var(--space-3); min-width:0; }
.ietm-ui .ui-row-between { display:flex; align-items:center; justify-content:space-between; gap:var(--space-3); min-width:0; }
.ietm-ui .ui-wrap { flex-wrap:wrap; }
.ietm-ui .ui-grow { flex:1; min-width:0; }
.ietm-ui .ui-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:var(--space-4); }
.ietm-ui .ui-grid-3 { grid-template-columns:repeat(3,minmax(0,1fr)); }
.ietm-ui .ui-divider { height:1px; width:100%; border:0; background:var(--border-subtle); margin:var(--space-4) 0; }
.ietm-ui .ui-section { margin-block:var(--space-10); }
.ietm-ui .ui-section:first-child { margin-top:0; }
.ietm-ui .ui-section-heading { display:flex; align-items:baseline; justify-content:space-between; gap:12px; margin-bottom:var(--space-4); }

/* 04. Typography and rich document formatting */
.ietm-ui .ui-eyebrow { color:var(--text-tertiary); font-size:var(--text-xs); font-weight:650; letter-spacing:.085em; text-transform:uppercase; }
.ietm-ui .ui-page-title { font-size:clamp(1.65rem,2.7vw,2.25rem); line-height:1.17; letter-spacing:-.035em; font-weight:650; }
.ietm-ui .ui-subtitle { font-size:var(--text-md); color:var(--text-secondary); line-height:1.6; }
.ietm-ui .ui-caption { color:var(--text-secondary); font-size:var(--text-xs); line-height:1.45; }
.ietm-ui .ui-document { font-size:15px; line-height:var(--line-reading); overflow-wrap:break-word; }
.ietm-ui .ui-document :where(h1,h2,h3,h4,h5,h6) { color:var(--text); line-height:1.3; letter-spacing:-.025em; font-weight:650; scroll-margin-top:88px; }
.ietm-ui .ui-document h1 { font-size:clamp(1.6rem,3vw,2rem); margin:0 0 1.25rem; }
.ietm-ui .ui-document h2 { font-size:1.4rem; margin:2.25rem 0 .85rem; }
.ietm-ui .ui-document h3 { font-size:1.15rem; margin:1.75rem 0 .65rem; }
.ietm-ui .ui-document h4 { font-size:1rem; margin:1.4rem 0 .55rem; }
.ietm-ui .ui-document h5, .ietm-ui .ui-document h6 { font-size:.91rem; margin:1.1rem 0 .45rem; }
.ietm-ui .ui-document :where(p,ul,ol,dl,blockquote,pre,figure,.ui-table-wrap) { margin-block:0 1rem; }
.ietm-ui .ui-document :where(strong,b) { font-weight:650; }
.ietm-ui .ui-document small { font-size:.85em; color:var(--text-secondary); }
.ietm-ui .ui-document mark { background:var(--warning-soft); color:var(--text); border-radius:2px; padding-inline:2px; }
.ietm-ui .ui-document :where(ul,ol) { padding-inline-start:1.65em; }
.ietm-ui .ui-document li { padding-inline-start:.3em; margin-block:.3rem; }
.ietm-ui .ui-document li::marker { color:var(--text-secondary); }
.ietm-ui .ui-document li > :where(ul,ol) { margin:.35rem 0; }
.ietm-ui .ui-document dl { display:grid; grid-template-columns:minmax(130px,1fr) minmax(0,2fr); column-gap:20px; row-gap:12px; }
.ietm-ui .ui-document dt { font-weight:650; }
.ietm-ui .ui-document dd { color:var(--text-secondary); }
.ietm-ui .ui-document blockquote { padding:10px 0 10px 18px; border-left:3px solid var(--border-strong); color:var(--text-secondary); }
.ietm-ui :where(a,.ui-link) { color:var(--accent); text-decoration:underline; text-underline-offset:3px; text-decoration-thickness:1px; }
.ietm-ui :where(a,.ui-link):hover { color:var(--accent-hover); text-decoration-thickness:1.5px; }
.ietm-ui .ui-link-quiet { color:inherit; text-decoration:none; }
.ietm-ui .ui-link-quiet:hover { color:var(--accent); text-decoration:underline; }
.ietm-ui code:not(pre code), .ietm-ui .ui-inline-code { border:1px solid var(--border-subtle); border-radius:5px; background:var(--code-bg); padding:.1em .34em; font: .88em var(--font-mono); overflow-wrap:anywhere; }
.ietm-ui pre { padding:18px; border:1px solid var(--border); border-radius:var(--radius-lg); background:var(--code-bg); font:13px/1.6 var(--font-mono); overflow:auto; white-space:pre; }
.ietm-ui pre code { padding:0; background:transparent; border:0; font:inherit; }
.ietm-ui kbd { border:1px solid var(--border-strong); border-bottom-width:2px; background:var(--surface-soft); padding:2px 6px; border-radius:5px; font:12px var(--font-mono); }
.ietm-ui .ui-lead { color:var(--text-secondary); font-size:1.1rem; line-height:1.65; }
.ietm-ui .ui-meta { display:flex; gap:8px 16px; align-items:center; flex-wrap:wrap; color:var(--text-tertiary); font-size:12px; }
.ietm-ui .ui-label { display:block; font-size:12px; font-weight:650; color:var(--text-secondary); margin-bottom:6px; }
.ietm-ui .ui-overline { color:var(--text-tertiary); font-size:11px; font-weight:700; text-transform:uppercase; letter-spacing:.09em; }

/* 05. Cards, callouts, panels, inline graphics */
.ietm-ui .ui-card { padding:20px; background:var(--surface); border:1px solid var(--border); border-radius:var(--radius-xl); }
.ietm-ui .ui-card-tight { padding:12px 14px; border-radius:var(--radius-lg); }
.ietm-ui .ui-card-raised { box-shadow:var(--shadow-sm); }
.ietm-ui .ui-card-interactive { transition:border-color var(--duration-fast),background var(--duration-fast),box-shadow var(--duration-fast); }
.ietm-ui .ui-card-interactive:hover { background:var(--surface-soft); border-color:var(--border-strong); box-shadow:var(--shadow-sm); }
.ietm-ui .ui-panel { background:var(--surface-muted); border:1px solid transparent; padding:16px 18px; border-radius:var(--radius-lg); }
.ietm-ui .ui-panel-bordered { background:var(--surface); border-color:var(--border); }
.ietm-ui .ui-callout { display:flex; align-items:flex-start; gap:12px; padding:14px 16px; border-radius:var(--radius-lg); background:var(--surface-muted); border:1px solid var(--border-subtle); line-height:1.55; }
.ietm-ui .ui-callout-body { flex:1; min-width:0; }
.ietm-ui .ui-callout-title { font-weight:650; font-size:14px; margin-bottom:4px; }
.ietm-ui .ui-callout p { margin:0; font-size:14px; }
.ietm-ui .ui-callout-info { background:var(--accent-soft); border-color:transparent; }
.ietm-ui .ui-callout-success { background:var(--positive-soft); border-color:transparent; }
.ietm-ui .ui-callout-warning { background:var(--warning-soft); border-color:transparent; }
.ietm-ui .ui-callout-danger { background:var(--danger-soft); border-color:transparent; }
.ietm-ui .ui-callout-icon { flex:none; width:19px; height:19px; color:var(--text-secondary); }
.ietm-ui .ui-callout-info .ui-callout-icon { color:var(--accent); }
.ietm-ui .ui-callout-success .ui-callout-icon { color:var(--positive); }
.ietm-ui .ui-callout-warning .ui-callout-icon { color:var(--warning); }
.ietm-ui .ui-callout-danger .ui-callout-icon { color:var(--danger); }
.ietm-ui .ui-badge { display:inline-flex; gap:5px; align-items:center; padding:3px 8px; border-radius:var(--radius-pill); background:var(--neutral-soft); color:var(--text-secondary); font-size:11px; font-weight:650; line-height:1.4; white-space:nowrap; }
.ietm-ui .ui-badge-info { background:var(--accent-soft); color:var(--accent); }
.ietm-ui .ui-badge-success { background:var(--positive-soft); color:var(--positive); }
.ietm-ui .ui-badge-warning { background:var(--warning-soft); color:var(--warning); }
.ietm-ui .ui-badge-danger { background:var(--danger-soft); color:var(--danger); }
.ietm-ui .ui-graphic { background:var(--surface-soft); border:1px solid var(--border); border-radius:var(--radius-xl); padding:20px; overflow:hidden; }
.ietm-ui .ui-graphic-title { display:flex; justify-content:space-between; align-items:center; gap:10px; font-weight:650; font-size:13px; margin-bottom:14px; }
.ietm-ui .ui-graphic svg { display:block; margin-inline:auto; width:100%; height:auto; }
.ietm-ui .ui-graphic-caption { text-align:center; font-size:12px; color:var(--text-secondary); margin-top:12px; }
.ietm-ui .ui-stat { border:1px solid var(--border); border-radius:var(--radius-lg); padding:16px; background:var(--surface); }
.ietm-ui .ui-stat-value { font-size:1.65rem; line-height:1.2; letter-spacing:-.025em; font-weight:650; margin-block:6px; }

/* 06. Tables — dense and document-grade */
.ietm-ui .ui-table-wrap { overflow:auto; width:100%; border:1px solid var(--border); border-radius:var(--radius-lg); background:var(--surface); }
.ietm-ui table.ui-table { width:100%; border-collapse:separate; border-spacing:0; font-size:13px; line-height:1.5; color:var(--text); }
.ietm-ui .ui-table :where(th,td) { padding:11px 14px; text-align:left; vertical-align:top; border-bottom:1px solid var(--border-subtle); }
.ietm-ui .ui-table th { font-weight:650; background:var(--surface-muted); color:var(--text-secondary); }
.ietm-ui .ui-table tr:last-child > :where(th,td) { border-bottom:0; }
.ietm-ui .ui-table tbody tr:hover > td { background:var(--surface-soft); }
.ietm-ui .ui-table-striped tbody tr:nth-child(even) > td { background:var(--table-stripe); }
.ietm-ui .ui-table-compact :where(th,td) { padding:7px 10px; }
.ietm-ui .ui-table-bordered :where(th,td) { border-right:1px solid var(--border-subtle); }
.ietm-ui .ui-table-bordered tr > :last-child { border-right:0; }
.ietm-ui .ui-table-sticky thead th { position:sticky; top:0; z-index:1; box-shadow:0 1px 0 var(--border); }
.ietm-ui .ui-table .ui-num { text-align:right; white-space:nowrap; font-variant-numeric:tabular-nums; }
.ietm-ui .ui-table caption { text-align:left; caption-side:top; font-size:12px; padding:10px 14px; color:var(--text-secondary); }
/* For authored S1000D tables retain rowspan/colspan, explicit headers and source semantics. */
.ietm-ui .ui-technical-table :where(th,td) { white-space:normal; overflow-wrap:anywhere; }
.ietm-ui .ui-technical-table th[scope="row"] { color:var(--text); background:var(--surface-soft); }
.ietm-ui .ui-technical-table td:empty::after { content:""; display:block; min-height:1em; }

/* 07. Lists, checklists, timelines and tree navigation */
.ietm-ui .ui-list { list-style:none; padding:0; margin:0; }
.ietm-ui .ui-list-row { display:flex; gap:12px; align-items:flex-start; padding:12px 0; border-bottom:1px solid var(--border-subtle); }
.ietm-ui .ui-list-row:last-child { border-bottom:0; }
.ietm-ui .ui-list-main { min-width:0; flex:1; }
.ietm-ui .ui-list-title { font-weight:600; font-size:14px; }
.ietm-ui .ui-list-description { color:var(--text-secondary); font-size:12px; margin-top:3px; }
.ietm-ui .ui-checklist { list-style:none; padding:0; margin:0; display:grid; gap:12px; }
.ietm-ui .ui-checklist li { display:flex; align-items:flex-start; gap:10px; padding:0; margin:0; }
.ietm-ui .ui-checklist input { margin-top:4px; accent-color:var(--accent); }
.ietm-ui .ui-timeline { list-style:none; margin:0; padding:0 0 0 14px; border-left:1px solid var(--border-strong); }
.ietm-ui .ui-timeline li { position:relative; padding:0 0 24px 20px; }
.ietm-ui .ui-timeline li::before { content:""; position:absolute; left:-19px; top:5px; background:var(--surface); border:2px solid var(--accent); width:9px; height:9px; border-radius:50%; }
.ietm-ui .ui-nav-heading { margin:18px 10px 6px; color:var(--text-tertiary); font-size:11px; font-weight:700; letter-spacing:.075em; text-transform:uppercase; }
.ietm-ui .ui-nav-item { display:flex; gap:10px; align-items:center; min-height:35px; width:100%; padding:8px 10px; border-radius:var(--radius-md); color:var(--text-secondary); text-decoration:none; font-size:13px; border:1px solid transparent; background:transparent; text-align:left; }
.ietm-ui .ui-nav-item:hover { background:var(--surface-hover); color:var(--text); text-decoration:none; }
.ietm-ui .ui-nav-item[aria-current="page"], .ietm-ui .ui-nav-item.is-active { background:var(--surface-active); color:var(--text); font-weight:650; }
.ietm-ui .ui-tree { padding:0; margin:0; list-style:none; font-size:13px; }
.ietm-ui .ui-tree .ui-tree { margin-left:12px; padding-left:12px; border-left:1px solid var(--border); }
.ietm-ui .ui-tree-row { display:flex; gap:8px; align-items:center; padding:7px 9px; border-radius:var(--radius-sm); cursor:pointer; }
.ietm-ui .ui-tree-row:hover { background:var(--surface-hover); }
.ietm-ui .ui-tree-row[aria-selected="true"] { background:var(--accent-soft); }
.ietm-ui .ui-breadcrumbs { display:flex; align-items:center; gap:7px; flex-wrap:wrap; color:var(--text-tertiary); font-size:12px; }
